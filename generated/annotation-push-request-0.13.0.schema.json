    "SchemaAssociationID": {
      "description": "Opaque durable Peasant identifier for one session-to-commit association",
      "examples": [
        "assoc-20260726:session-a:commit-1"
      ],
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Association ID",
      "type": "string"
    },
    "SchemaProjectHash": {
      "description": "SHA-256 hex digest of the project's origin URL or local path",
      "examples": [
        "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"
      ],
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Hash",
      "type": "string"
    },
    "SchemaProvenance": {
      "properties": {
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "function": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "method"
      ],
      "type": "object"
    },
    "SchemaTargetKind": {
      "description": "What is being annotated: session-level, entry-level (turn/tool call), meta-annotation, project-level, a specific file version (content-hash keyed read-state receipt), or a durable session-to-commit association",
      "enum": [
        "session",
        "entry",
        "annotation",
        "project",
        "file_version",
        "association"
      ],
      "examples": [
        "session",
        "entry",
        "file_version",
        "association"
      ],
      "title": "Target Kind",
      "type": "string"
    }
  },
  "$id": "urn:peasant:annotation-push-request:0.13.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "JSON Schema for the Village annotation push request wire format, extracted from the village-api OpenAPI spec (peasant is the source of truth; the village vendors + enforces this schema).",
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/SchemaAnnotationPushItem"
      },
      "type": "array"
    },
    "retractions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "annotations"
  ],
  "title": "Annotation Push Request Schema",
  "type": "object"
