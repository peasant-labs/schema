{
  "openapi": "3.1.0",
  "info": {
    "title": "Peasant Local Dashboard API",
    "description": "Local web dashboard API for viewing AI agent session analytics. Includes REST endpoints and WebSocket channel message schemas.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/annotation-types": {
      "get": {
        "tags": [
          "annotations"
        ],
        "description": "List all registered annotation types.",
        "operationId": "listAnnotationTypes",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter by lifecycle status (active, deprecated, etc.)",
            "schema": {
              "description": "Filter by lifecycle status (active, deprecated, etc.)",
              "type": "string"
            }
          },
          {
            "name": "origin",
            "in": "query",
            "description": "Filter by origin (system, user, group)",
            "schema": {
              "description": "Filter by origin (system, user, group)",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SchemaAnnotationTypeSummary"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/annotations": {
      "get": {
        "tags": [
          "annotations"
        ],
        "description": "List annotations for a session.",
        "operationId": "listAnnotations",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "description": "Session ID to filter annotations",
            "required": true,
            "schema": {
              "description": "Session ID to filter annotations",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SchemaAnnotationSummary"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "annotations"
        ],
        "description": "Create a new annotation.",
        "operationId": "createAnnotation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchemaCreateAnnotationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaCreateAnnotationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config/mock": {
      "get": {
        "tags": [
          "config"
        ],
        "description": "Get mock data configuration.",
        "operationId": "getMockConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaMockConfigResponse"
                },
                "examples": {
                  "mocksEnabled": {
                    "summary": "Mock data enabled for web",
                    "value": {
                      "enabled": true,
                      "web": [
                        "dashboard",
                        "sessions",
                        "trends"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "description": "Health check endpoint.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaHealthResponse"
                },
                "examples": {
                  "healthy": {
                    "summary": "Healthy server",
                    "value": {
                      "status": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "tags": [
          "sessions"
        ],
        "description": "List session summaries.",
        "operationId": "listSessions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaSessionsPayload"
                },
                "examples": {
                  "twoSessions": {
                    "summary": "Two session summaries",
                    "value": {
                      "sessions": [
                        {
                          "durationMins": 45.2,
                          "harness": "claude-code",
                          "id": "99d59925-36bc-424c-a789-8be54d9702ba",
                          "project": "myapp",
                          "startTime": "2024-02-28T10:00:00Z",
                          "toolCallCount": 8,
                          "totalTokens": 23000,
                          "turnCount": 12
                        },
                        {
                          "durationMins": 22.7,
                          "harness": "opencode",
                          "id": "b2c3d4e5-6789-0abc-def1-234567890abc",
                          "project": "another-project",
                          "startTime": "2024-02-28T14:30:00Z",
                          "toolCallCount": 4,
                          "totalTokens": 11500,
                          "turnCount": 6
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "description": "Get session detail by ID.",
        "operationId": "getSession",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaSessionDetailPayload"
                },
                "examples": {
                  "detailedSession": {
                    "summary": "Session with turns",
                    "value": {
                      "durationMins": 45.2,
                      "endTime": "2024-02-28T10:45:12Z",
                      "harness": "claude-code",
                      "id": "99d59925-36bc-424c-a789-8be54d9702ba",
                      "startTime": "2024-02-28T10:00:00Z",
                      "tokensIn": 15000,
                      "tokensOut": 8000,
                      "toolCallCount": 1,
                      "totalTokens": 23000,
                      "turnCount": 2,
                      "turns": [
                        {
                          "content": "Add OpenAPI examples to the schema types",
                          "depth": 0,
                          "index": 0,
                          "role": "user",
                          "timestamp": "2024-02-28T10:00:00Z"
                        },
                        {
                          "content": "I'll add WithExamples calls to each JSONSchema method...",
                          "depth": 0,
                          "index": 1,
                          "role": "assistant",
                          "timestamp": "2024-02-28T10:00:15Z",
                          "toolCalls": [
                            {
                              "arguments": "{\"path\":\"pkg/schema/types.go\"}",
                              "id": "tool_01",
                              "name": "Read",
                              "result": "file contents..."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/shutdown": {
      "post": {
        "tags": [
          "lifecycle"
        ],
        "description": "Gracefully shutdown the server (localhost only).",
        "operationId": "postShutdown",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaShutdownResponse"
                },
                "examples": {
                  "shuttingDown": {
                    "summary": "Server shutting down",
                    "value": {
                      "status": "shutting_down"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
