{
  "$defs": {
    "BestiaryHarness": {
      "description": "AI coding tool or development environment",
      "enum": [
        "claude-code",
        "gemini-cli",
        "codex",
        "opencode",
        "cursor",
        "antigravity",
        "strike"
      ],
      "examples": [
        "claude-code",
        "opencode"
      ],
      "title": "Harness",
      "type": "string"
    },
    "SchemaAssociationID": {
      "description": "Opaque durable Peasant identifier for one session-to-commit association",
      "examples": [
        "assoc-20260726:session-a:commit-1"
      ],
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Association ID",
      "type": "string"
    },
    "SchemaAuthoritativeCommitInfo": {
      "additionalProperties": false,
      "properties": {
        "authorEmail": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "authorTime": {
          "format": "int64",
          "type": "integer"
        },
        "commitTime": {
          "format": "int64",
          "type": "integer"
        },
        "hash": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "hash",
        "message",
        "authorName",
        "authorEmail",
        "commitTime",
        "authorTime"
      ],
      "type": "object"
    },
