    "SchemaEntryType": {
      "description": "Classification of a single entry within an agent session transcript",
      "enum": [
        "text",
        "tool_use",
        "tool_result",
        "thinking",
        "system",
        "error",
        "result"
      ],
      "examples": [
        "text",
        "tool_use",
        "tool_result"
      ],
      "title": "Entry Type",
      "type": "string"
    },
    "SchemaHostSlug": {
      "description": "Sanitized, filesystem-safe identifier derived from git remote; contains only [a-zA-Z0-9._\u003c\u003e-]",
      "examples": [
        "github.com--user--repo",
        "local--home-user-projects-myapp"
      ],
      "pattern": "^[a-zA-Z0-9._\u003c\u003e-]+$",
      "title": "Host Slug",
      "type": "string"
    },
    "SchemaLicense": {
      "description": "Content license for a published transcript",
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0"
      ],
      "examples": [
        "CC0-1.0"
      ],
      "title": "License",
      "type": "string"
    },
    "SchemaModelID": {
      "description": "Model identifier (e.g. 'claude-opus-4-6', 'gemini-2.0-flash')",
      "examples": [
        "claude-opus-4-6",
        "gemini-2.0-flash",
        "codex-mini-latest"
      ],
      "minLength": 1,
      "title": "Model ID",
      "type": "string"
    },
    "SchemaProjectHash": {
      "description": "SHA-256 hex digest of the project's origin URL or local path",
      "examples": [
        "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"
      ],
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Hash",
      "type": "string"
    },
    "SchemaPublishedAssociation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/SchemaAssociationID"
        },
        "observedCommitHash": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "observedCommitHash"
      ],
      "type": "object"
    },
    "SchemaRole": {
      "description": "Sender role of a message turn",
      "enum": [
        "user",
        "assistant",
        "tool",
        "system"
      ],
      "examples": [
        "user",
        "assistant"
      ],
      "title": "Role",
      "type": "string"
    },
    "SchemaSessionID": {
      "description": "Unique session identifier (UUID, agent-{hex}, ses_{id}, sess_{id} (ACP), msg_{id}, or a Strike session ID)",
      "examples": [
        "99d59925-36bc-424c-a789-8be54d9702ba",
        "agent-a3aee4f",
        "ses_3cd91f52effeXd3QAJ54jOyzv5",
        "sess_3cd91f52effeXd3QAJ54jOyzv5",
        "20260728T123456.123456789Z-ABCDEFGHIJKLMNOPQRST234567",
        "ABCDEFGHIJKLMNOPQRST234567"
      ],
      "format": "session-id",
      "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|agent-[a-f0-9]+|sess?_[a-zA-Z0-9]+|msg_[a-zA-Z0-9]+|[0-9]{8}T[0-9]{6}\\.[0-9]{9}Z-[A-Z2-7]{26}|[A-Z2-7]{26})$",
      "title": "Session ID",
      "type": "string"
    },
    "SchemaSessionOutcome": {
      "description": "Resolution status of the session",
      "enum": [
        "resolved",
        "partial",
        "failed"
      ],
      "examples": [
        "resolved",
        "partial",
        "failed"
      ],
      "title": "Session Outcome",
      "type": "string"
    },
    "SchemaSourceFormat": {
      "description": "Transcript file format",
      "enum": [
        "jsonl",
        "json"
      ],
      "examples": [
        "jsonl",
        "json"
      ],
      "title": "Source Format",
      "type": "string"
    },
    "SchemaStopReason": {
      "description": "Reason why a session or turn ended (ACP-aligned)",
      "enum": [
        "end_turn",
        "cancelled",
        "max_tokens",
        "max_turn_requests",
        "refusal"
      ],
      "examples": [
        "end_turn",
        "max_tokens"
      ],
      "title": "Stop Reason",
      "type": "string"
    },
    "SchemaToolCallKind": {
      "description": "Classification of a tool call, aligned with ACP ToolCallUpdate.kind",
      "enum": [
        "read",
        "edit",
        "delete",
        "move",
        "search",
        "execute",
        "think",
        "fetch",
        "other"
      ],
      "examples": [
        "read",
        "edit",
        "execute"
      ],
      "title": "Tool Call Kind",
      "type": "string"
    },
    "SchemaTranscriptContentHash": {
      "description": "SHA3-256 digest of the exact transcript file bytes",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transcript Content Hash",
      "type": "string"
    },
    "SchemaVisibilityIntent": {
      "description": "Optional desired final access for legacy compatibility; content replacement remains private and widening occurs separately",
      "enum": [
        "private",
        "public"
      ],
      "examples": [
        "private",
        "public"
      ],
      "title": "Visibility Intent",
      "type": "string"
    }
  },
  "$id": "urn:peasant:publish-request:0.11.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "JSON Schema for peasant push PublishRequest wire format, extracted from the village-api OpenAPI spec (peasant is the source of truth; the village vendors + enforces this schema).",
  "properties": {
    "contentHash": {
      "$ref": "#/$defs/SchemaTranscriptContentHash"
    },
    "diagnostics": {
      "$ref": "#/$defs/SchemaAuthoritativeDiagnosticsInfo"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SchemaAuthoritativeSessionEntry"
      },
      "type": "array"
    },
    "git": {
      "$ref": "#/$defs/SchemaAuthoritativeGitContext"
    },
    "identity": {
      "$ref": "#/$defs/SchemaAuthoritativeSessionIdentity"
    },
    "license": {
      "$ref": "#/$defs/SchemaLicense"
    },
    "model": {
      "$ref": "#/$defs/SchemaAuthoritativeModelInfo"
    },
    "project": {
      "$ref": "#/$defs/SchemaAuthoritativeProjectContext"
    },
    "quality": {
      "$ref": "#/$defs/SchemaAuthoritativeQualityMetrics"
    },
    "source": {
      "$ref": "#/$defs/SchemaAuthoritativeSourceInfo"
    },
    "stats": {
      "$ref": "#/$defs/SchemaAuthoritativeSessionStats"
    },
    "subagents": {
      "items": {
        "$ref": "#/$defs/SchemaAuthoritativeSubagentRef"
      },
      "type": "array"
    },
    "timestamp": {
      "$ref": "#/$defs/SchemaAuthoritativeTimestampInfo"
    },
    "visibilityIntent": {
      "$ref": "#/$defs/SchemaVisibilityIntent"
    }
  },
  "required": [
    "contentHash",
    "model"
  ],
  "title": "Publish Request Schema",
  "type": "object"
}