{
  "openapi": "3.1.0",
  "info": {
    "title": "Peasant Segmented Read Protocol v0.1.0",
    "description": "This document owns segmented read shapes; the host API document owns the routes. Routes:\n- GET /api/v1/transcripts/{id}/segments (getTranscriptSegments)\n- GET /api/v1/transcripts/{id}/segments/{index} (getTranscriptSegment)\n- GET /api/v1/transcripts/{id}/window (getTranscriptWindow)\nProtocol generation selectors (omission is v=0):\n- v=0 -\u003e 0.1.0\n- v=1 -\u003e 0.1.0\n- v=2 -\u003e 0.2.0",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "ActorOrigin": {
        "description": "Closed session graph value",
        "enum": [
          "operator",
          "agent_delegate",
          "harness",
          "unknown"
        ],
        "examples": [
          "operator",
          "agent_delegate",
          "harness",
          "unknown"
        ],
        "title": "Actor Origin",
        "type": "string"
      },
      "CommandInvocation": {
        "properties": {
          "args": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ContentOrigin": {
        "description": "Closed session graph value",
        "enum": [
          "submitted_input",
          "harness_context",
          "agent_output",
          "agent_communication",
          "tool_activity",
          "system_control",
          "generated_summary",
          "unknown"
        ],
        "examples": [
          "submitted_input",
          "harness_context",
          "agent_output",
          "agent_communication",
          "tool_activity",
          "system_control",
          "generated_summary",
          "unknown"
