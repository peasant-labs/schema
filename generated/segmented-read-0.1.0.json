      },
      "ImageMediaType": {
        "description": "Recorded image media type: image/png or image/jpeg",
        "enum": [
          "image/png",
          "image/jpeg"
        ],
        "examples": [
          "image/png",
          "image/jpeg"
        ],
        "title": "Image Media Type",
        "type": "string"
      },
      "ImagePart": {
        "properties": {
          "byteSize": {
            "description": "Exact stored byte size. Zero means unset or no bytes, and an explicit zero is accepted as unset; a published transcript never carries a nonzero size.",
            "minimum": 0,
            "type": "integer"
          },
          "height": {
            "description": "Optional recorded pixel height; zero means unset or unknown, and an explicit zero is accepted as unset. A published transcript never carries a nonzero height.",
            "minimum": 0,
            "type": "integer"
          },
          "mediaType": {
            "$ref": "#/components/schemas/ImageMediaType",
            "description": "Recorded image/png or image/jpeg media type. Absent for an unsupported source type or a published transcript."
          },
          "omittedReason": {
            "$ref": "#/components/schemas/OmittedReason",
            "description": "Why the bytes are absent: unsupported (wins for a non-recorded media type), too_large, missing, or not_published. Omit when local bytes are present."
          },
          "ref": {
            "description": "Lowercase 64-hex content address of the stored image. Absent when the bytes are omitted or the transcript is published.",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "width": {
            "description": "Optional recorded pixel width; zero means unset or unknown, and an explicit zero is accepted as unset. A published transcript never carries a nonzero width.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "InputModality": {
        "description": "Closed session graph value",
        "enum": [
          "none",
          "text",
          "media",
          "user_action",
          "mixed",
          "unknown"
        ],
        "examples": [
          "none",
          "text",
          "media",
          "user_action",
          "mixed",
          "unknown"
        ],
        "title": "Input Modality",
        "type": "string"
      },
      "ObservedModelID": {
        "description": "Exact UTF-8 model identifier observed on an assistant-generated turn; producer-enforced as assistant or subagent evidence. Values are non-empty and may not have a Unicode White_Space code point at either edge; all accepted bytes, including Unicode, mixed case, slashes, and internal spaces, are preserved.",
        "examples": [
          "anthropic/Claude-Opus-4-8",
          "provider/Model Family"
        ],
        "minLength": 1,
        "pattern": "^(?:﻿|[^\\s])(?:[\\s\\S]*(?:﻿|[^\\s]))?$",
        "title": "Observed Model ID",
        "type": "string"
      },
      "OmittedReason": {
        "description": "Why an image part carries no bytes: unsupported (wins for a non-recorded media type), too_large, missing, or not_published",
        "enum": [
          "too_large",
          "unsupported",
          "missing",
          "not_published"
        ],
        "examples": [
          "too_large",
          "unsupported",
          "missing",
          "not_published"
        ],
        "title": "Omitted Reason",
        "type": "string"
      },
      "RecordedCostDetail": {
        "properties": {
          "cacheRead": {
            "anyOf": [
              {
                "type": [
                  "null",
                  "string"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "cacheWrite": {
            "anyOf": [
              {
                "type": [
                  "null",
                  "string"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "input": {
            "anyOf": [
