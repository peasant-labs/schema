                "type": [
                  "null",
                  "string"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "output": {
            "anyOf": [
              {
                "type": [
                  "null",
                  "string"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
